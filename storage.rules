rules_version = '2';service firebase.storage {match /b/{bucket}/o {match /gallery/{allPaths=**}{allow read:if true;allow write:if request.auth!=null && request.auth.token.admin==true && request.resource!=null && request.resource.size<8*1024*1024 && request.resource.contentType.matches('image/.*');}match /{allPaths=**}{allow read,write:if false;}}}