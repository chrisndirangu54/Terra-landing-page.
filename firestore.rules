rules_version = '2';service cloud.firestore {match /databases/{database}/documents {function admin(){return request.auth!=null && request.auth.token.admin==true;} match /gallery/{id}{allow read:if resource.data.published==true || admin();allow create,update,delete:if admin();}match /products/{id}{allow read:if resource.data.active==true || admin();allow create,update,delete:if admin();}match /orders/{id}{allow read:if admin() || (request.auth!=null && resource.data.uid==request.auth.uid);allow write:if false;}match /{document=**}{allow read,write:if false;}}}